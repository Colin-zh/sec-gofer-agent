# sec 本地运行配置模板；复制为 .env 后按需调整。
# SecClient/AsyncSecClient 显式参数 > 进程环境变量 > .env > 代码默认值。
# 不要提交包含真实凭据的 .env。

# 1. Provider 选择与通用覆盖项
SEC_PROVIDER=openai
SEC_MODEL=
SEC_API_KEY=
SEC_BASE_URL=

# 2. OpenAI 配置：SEC_* 通用值存在时优先使用
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# 3. Anthropic 配置：SEC_* 通用值存在时优先使用
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=

# 4. 模型请求参数
SEC_REQUEST_TIMEOUT_SECONDS=60
SEC_MAX_OUTPUT_TOKENS=8192
SEC_MODEL_MAX_ATTEMPTS=3
SEC_MODEL_RETRY_BASE_DELAY_SECONDS=0.5
SEC_MODEL_RETRY_MAX_DELAY_SECONDS=8

# 4.1 小模型层（可选）：为低复杂度场景（记忆判别、事实抽取、上下文/span 摘要、
# 意图分类、查询改写、LLM-as-Judge 等）切换到更快/更便宜的小模型以降低时延。
# 未设置 SEC_SMALL_MODEL 时整层关闭，所有场景复用主模型（与默认行为一致）。
# SEC_SMALL_MODEL=
# SEC_SMALL_PROVIDER=          # 默认沿用 SEC_PROVIDER
# SEC_SMALL_API_KEY=           # 默认沿用主 provider 的 API key
# SEC_SMALL_BASE_URL=          # 默认沿用主 provider 的 base_url

# 4.2 辅助推理步骤开关（小模型层关闭时，这些步骤改用主模型执行）
# SEC_AUX_ENABLED=false
# SEC_AUX_INTENT_ENABLED=true       # 意图分类 + 内容路由（简单任务落到小模型）
# SEC_AUX_REWRITE_ENABLED=true      # 检索前查询改写
# SEC_AUX_JUDGE_ENABLED=false       # LLM-as-Judge 输出判断（默认关）
# SEC_AUX_TRACE_SUMMARY_ENABLED=false  # trace 摘要（默认关）
# SEC_AUX_MAX_CALLS_PER_TURN=4      # 每轮辅助步骤的小模型调用预算

# 5. 工具重试；默认仅一次尝试，且工具必须显式标记 retry_safe
SEC_TOOL_MAX_ATTEMPTS=1
SEC_TOOL_RETRY_BASE_DELAY_SECONDS=0.5
SEC_TOOL_RETRY_MAX_DELAY_SECONDS=8

# 6. Agent 每个 turn 的调用预算；follow-up 会开启新 turn 并重置预算
SEC_AGENT_MAX_MODEL_CALLS=128
SEC_AGENT_MAX_TOOL_CALLS=64

# 7. Run 事件缓冲
SEC_EVENT_BUFFER_SIZE=128
# 可选工作区根目录；未设置时 CLI 使用当前目录，SDK 使用传入的 workspace 或当前目录兜底。
# SEC_ROOT_PATH=/path/to/workspace

# 8. 可选上下文压缩
# 启用时必须在 Client 中同时配置窗口并注入匹配 Provider 的 TokenEstimator。
# SDK 不根据字符数或比例猜测 token 数；未设置窗口时压缩关闭。
# SEC_CONTEXT_WINDOW_TOKENS=
# SEC_CONTEXT_COMPRESSION_THRESHOLD=0.8

# 9. Session 历史存储：以下三种配置任选一种，不要同时启用。
# Desktop Trace 存储跟随此配置：database 使用同一个 Client Database，并迁移已有
# 本地 Trace 数据库；未配置 Database 时使用工作区本地 SQLite。
# 本地 Trace 数据库路径可单独配置；相对路径以工作区为基准。
# SEC_DESKTOP_TRACE_STORE_PATH=.sec/desktop-traces.sqlite3
# A. 仅保存在当前进程；进程退出后 Session 历史不会保留。
# SEC_SESSION_STORE_BACKEND=in_memory
# SEC_DATABASE_URL=
#
# B. 本地 SQLite（默认示例）。
SEC_SESSION_STORE_BACKEND=database
SEC_DATABASE_URL=sqlite+aiosqlite:///sec.db
#
# C. openGauss。使用前在项目根目录运行 uv sync --extra opengauss。
# 项目将 SQLAlchemy 固定在兼容的 2.0.x 范围；仍需针对目标 openGauss 服务验证连接。
# 密码使用原始值，无需进行 URL 编码。启用此项时，注释掉上面的 SQLite URL。
# SEC_SESSION_STORE_BACKEND=database
# SEC_DATABASE_DRIVER=opengauss+asyncpg
# SEC_DATABASE_HOST=your-opengauss-host
# SEC_DATABASE_PORT=5432
# SEC_DATABASE_USERNAME=your-username
# SEC_DATABASE_PASSWORD=your-password
# SEC_DATABASE_NAME=your-database
# SEC_DATABASE_SCHEMA=sec

# 10. 长期记忆（可选，默认关闭）。开启后 gate / 事实抽取会额外消耗模型调用。
# SEC_MEMORY_ENABLED=false
# SEC_MEMORY_BACKEND=auto          # auto 跟随 SessionStore 后端；in_memory | database
# SEC_MEMORY_TOP_K=5
# SEC_MEMORY_TOKEN_BUDGET=2048
# USER.md 默认创建在工作区 .sec/USER.md；可用此项指定其他位置。
# SEC_MEMORY_USER_MD_PATH=
# SEC_MEMORY_GATE_ENABLED=true
# SEC_MEMORY_CONSOLIDATION_ENABLED=true
# SEC_MEMORY_PROCEDURAL_CONSOLIDATION_ENABLED=true  # 模型提炼用户偏好写入 USER.md
# SEC_MEMORY_VECTOR_DIM=1536

# 11. 向量检索 Embedder（仅 postgresql / openGauss 等向量方言需要）。
# 当记忆后端落到向量方言时，必须同时设置 SEC_EMBEDDING_BASE_URL 与
# SEC_EMBEDDING_MODEL，否则初始化报错
#   "vector backend requires an Embedder for semantic memory"。
# Embedder 为自托管 OpenAI 兼容接口；SQLite 后端只走 FTS5，无需配置。
# SEC_EMBEDDING_BASE_URL=
# SEC_EMBEDDING_MODEL=
# SEC_EMBEDDING_API_KEY=
# SEC_EMBEDDING_REQUEST_TIMEOUT_SECONDS=60