      "boundElements": null,
      "updated": 1790998476975,
      "link": null,
      "locked": false,
      "text": "对比泛用的loop骨架：\n\nfor iteration in range(1, max_iterations + 1):\n    response = llm(messages, tools)                    # reason\n    if not tool_uses:\n        return reply                                   # guardrail 1\n    for call in tool_uses:\n        output = tools.execute(call.name, call.input)  # act\n        messages.append(tool_result)                   # observe\nreturn \"达到迭代上限\"                                    # guardrail 2\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "hF_gd9EO5IZsirGMDl63Q",
      "originalText": "对比泛用的loop骨架：\n\nfor iteration in range(1, max_iterations + 1):\n    response = llm(messages, tools)                    # reason\n    if not tool_uses:\n        return reply                                   # guardrail 1\n    for call in tool_uses:\n        output = tools.execute(call.name, call.input)  # act\n        messages.append(tool_result)                   # observe\nreturn \"达到迭代上限\"                                    # guardrail 2\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
